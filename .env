# -------------------------------------------------------------
# CONFIGURACIÓN DE APIS (Canedo Web Studio)
# -------------------------------------------------------------

# 1. OPENROUTER (Para usar modelos de IA Gratis como Llama 3 o Gemini Free)
# Entra en openrouter.ai, crea una API Key y pégala aquí abajo.
OPENROUTER_API_KEY="pega-tu-api-de-openrouter-aqui"

# 2. GENERACIÓN DE IMÁGENES
# Como vamos a usar herramientas GRATIS, dejaremos esto vacío. 
# El kit utilizará automáticamente "Openverse" (un banco de imágenes profesionales y gratuitas sin derechos de autor) 
# en lugar de gastar dinero en DALL-E.
OPENAI_API_KEY=""
