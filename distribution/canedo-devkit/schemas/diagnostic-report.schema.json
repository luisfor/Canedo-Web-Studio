{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Entrada de diagnóstico, esquema 2; campos no utilizados se descartan",
  "type": "object",
  "required": [
    "schemaVersion",
    "system",
    "checks",
    "packageManagers"
  ],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "system": {
      "type": "object",
      "required": [
        "platform",
        "architecture"
      ],
      "properties": {
        "platform": {
          "type": "string",
          "pattern": "^[a-z0-9-]{1,32}$"
        },
        "architecture": {
          "type": "string",
          "pattern": "^[a-z0-9_-]{1,32}$"
        },
        "version": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 100
        },
        "release": {
          "type": [
            "string",
            "null"
          ],
          "maxLength": 100
        },
        "distribution": {
          "type": [
            "object",
            "null"
          ],
          "properties": {
            "id": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 100
            },
            "version": {
              "type": [
                "string",
                "null"
              ],
              "maxLength": 100
            },
            "like": {
              "type": "array",
              "maxItems": 30,
              "items": {
                "type": "string",
                "maxLength": 80
              }
            }
          }
        }
      }
    },
    "checks": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "object",
        "required": [
          "tool",
          "status",
          "version"
        ],
        "properties": {
          "tool": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          },
          "status": {
            "enum": [
              "detected",
              "missing",
              "unverifiable",
              "incompatible",
              "unsupported",
              "error"
            ]
          },
          "version": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 80,
            "pattern": "^\\d[\\w.+-]{0,79}$"
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "status": {
                  "enum": [
                    "detected",
                    "incompatible"
                  ]
                }
              }
            },
            "then": {
              "properties": {
                "version": {
                  "type": "string"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "status": {
                  "const": "missing"
                }
              }
            },
            "then": {
              "properties": {
                "version": {
                  "type": "null"
                }
              }
            }
          }
        ]
      }
    },
    "packageManagers": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "required": [
          "id",
          "status"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          },
          "status": {
            "enum": [
              "detected",
              "missing",
              "unverifiable",
              "incompatible",
              "unsupported",
              "error"
            ]
          },
          "version": {
            "type": [
              "string",
              "null"
            ],
            "maxLength": 80,
            "pattern": "^\\d[\\w.+-]{0,79}$"
          }
        }
      }
    }
  }
}
