{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "text"
  ],
  "properties": {
    "text": {
      "type": "string",
      "minLength": 3,
      "maxLength": 4000
    },
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{0,40}$"
    },
    "architecture": {
      "enum": [
        "auto",
        "modular-monolith",
        "independent-services"
      ]
    },
    "docker": {
      "type": "boolean"
    },
    "nodeVersion": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "catalogExtension": {
      "const": null
    },
    "interpretation": {
      "const": null
    },
    "runtimeVersions": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9-]{0,63}$"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^\\d+\\.\\d+\\.\\d+$"
      }
    }
  }
}
