# Config personal de cada ordenador — no se comparte ni se sube a git
.claude/settings.local.json

# Marcador que crea /setup en cada ordenador
.claude/setup-completado.json

# Cazas: trabajo con webs de negocios reales — no se distribuyen con el kit
cazas/*
!cazas/.gitkeep
.env
.env.local
.env.*
!.env.example
*.local.json

# Secretos del kit (tokens del robot del blog, etc.) — NUNCA se suben
secretos/

# Estado local de Cloudflare Wrangler — solo sirve en este ordenador
.wrangler/
# Dependencias
node_modules/

# QA temporal
.qa-workspace/
