{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Design Spec Schema",
  "type": "object",
  "required": ["metadata", "viewport", "designSystem", "assets", "sections"],
  "properties": {
    "metadata": {
      "type": "object",
      "required": ["version", "sourceType", "originalFile", "fileType", "analyzedAt", "provider", "model"],
      "properties": {
        "version": { "type": "string" },
        "sourceType": { "type": "string", "enum": ["png", "jpg", "jpeg", "webp", "pdf"] },
        "inferredMobile": { "type": "boolean" },
        "originalFile": { "type": "string" },
        "fileType": { "type": "string" },
        "fileSize": { "type": "number" },
        "width": { "type": "number" },
        "height": { "type": "number" },
        "pages": { "type": "number" },
        "analyzedAt": { "type": "string" },
        "analyzerVersion": { "type": "string" },
        "provider": { "type": "string" },
        "model": { "type": "string" }
      }
    },
    "viewport": {
      "type": "object",
      "required": ["referenceSize"],
      "properties": {
        "referenceSize": { "type": "string" }
      }
    },
    "designSystem": {
      "type": "object",
      "required": ["colors", "typography", "spacing", "breakpoints"],
      "properties": {
        "colors": { "type": "object" },
        "typography": { "type": "object" },
        "spacing": { "type": "object" },
        "breakpoints": { "type": "object" }
      }
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "status"],
        "properties": {
          "id": { "type": "string" },
          "type": { "type": "string" },
          "status": { "type": "string", "enum": ["PROVIDED", "EXTRACTABLE", "MISSING", "PLACEHOLDER", "RECREATE"] },
          "provenance": {
            "type": "object",
            "properties": {
              "source": { "type": "string", "enum": ["EXACT", "INFERRED", "APPROXIMATE"] },
              "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
            }
          }
        }
      }
    },
    "sections": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "type", "components"],
        "properties": {
          "id": { "type": "string" },
          "type": { "type": "string" },
          "layout": { "type": "object" },
          "style": { "type": "object" },
          "responsive": { "type": "object" },
          "components": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["id", "type"],
              "properties": {
                "id": { "type": "string" },
                "type": { "type": "string" },
                "content": { "type": "string" },
                "layout": { "type": "object" },
                "style": { "type": "object" },
                "responsive": { "type": "object" },
                "provenance": {
                  "type": "object",
                  "properties": {
                    "source": { "type": "string", "enum": ["EXACT", "INFERRED", "APPROXIMATE"] },
                    "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
