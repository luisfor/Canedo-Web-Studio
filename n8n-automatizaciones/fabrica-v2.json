{
  "name": "Fábrica de Videos Guerrilla V2 (Con Editor FFmpeg)",
  "nodes": [
    {
      "parameters": {},
      "id": "e67e3a9c-0c4a-4d92-9f33-1463e26b86f8",
      "name": "Schedule Trigger",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1,
      "position": [0, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.openai.com/v1/chat/completions",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "model", "value": "gpt-4o-mini" },
            { "name": "messages", "value": "[{\"role\": \"user\", \"content\": \"Escribe un guion de 10 segundos.\"}]" }
          ]
        }
      },
      "id": "8b52f1e4-8b63-4c91-b3b4-f089608c02c6",
      "name": "OpenAI Guionista",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [200, 300]
    },
    {
      "parameters": {
        "url": "https://api.openai.com/v1/audio/speech",
        "method": "POST",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendBody": true,
        "bodyParameters": {
          "parameters": [
            { "name": "model", "value": "tts-1" },
            { "name": "input", "value": "={{ $json.choices[0].message.content }}" },
            { "name": "voice", "value": "onyx" }
          ]
        },
        "options": {
          "response": {
            "response": {
              "responseFormat": "file"
            }
          }
        }
      },
      "id": "voz-node",
      "name": "Text-To-Speech",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [400, 300]
    },
    {
      "parameters": {
        "fileName": "/Users/luis/Desktop/Canedo-Web-Studio-v1/n8n-automatizaciones/estudio-render/voz.mp3"
      },
      "id": "write-voz",
      "name": "Guardar Voz",
      "type": "n8n-nodes-base.writeBinaryFile",
      "typeVersion": 1,
      "position": [600, 300]
    },
    {
      "parameters": {
        "url": "https://api.pexels.com/videos/search?query=technology&orientation=portrait&per_page=1",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "options": {
          "response": {
            "response": {
              "responseFormat": "file"
            }
          }
        }
      },
      "id": "pexels-node",
      "name": "Pexels Camarógrafo",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.1,
      "position": [800, 300]
    },
    {
      "parameters": {
        "fileName": "/Users/luis/Desktop/Canedo-Web-Studio-v1/n8n-automatizaciones/estudio-render/video.mp4"
      },
      "id": "write-video",
      "name": "Guardar Video",
      "type": "n8n-nodes-base.writeBinaryFile",
      "typeVersion": 1,
      "position": [1000, 300]
    },
    {
      "parameters": {
        "command": "ffmpeg -y -i /Users/luis/Desktop/Canedo-Web-Studio-v1/n8n-automatizaciones/estudio-render/video.mp4 -i /Users/luis/Desktop/Canedo-Web-Studio-v1/n8n-automatizaciones/estudio-render/voz.mp3 -c:v copy -c:a aac -map 0:v:0 -map 1:a:0 -shortest /Users/luis/Desktop/Canedo-Web-Studio-v1/n8n-automatizaciones/estudio-render/final.mp4"
      },
      "id": "ffmpeg-node",
      "name": "El Editor (FFmpeg)",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [1200, 300]
    }
  ],
  "connections": {
    "Schedule Trigger": { "main": [ [ { "node": "OpenAI Guionista", "type": "main", "index": 0 } ] ] },
    "OpenAI Guionista": { "main": [ [ { "node": "Text-To-Speech", "type": "main", "index": 0 } ] ] },
    "Text-To-Speech": { "main": [ [ { "node": "Guardar Voz", "type": "main", "index": 0 } ] ] },
    "Guardar Voz": { "main": [ [ { "node": "Pexels Camarógrafo", "type": "main", "index": 0 } ] ] },
    "Pexels Camarógrafo": { "main": [ [ { "node": "Guardar Video", "type": "main", "index": 0 } ] ] },
    "Guardar Video": { "main": [ [ { "node": "El Editor (FFmpeg)", "type": "main", "index": 0 } ] ] }
  }
