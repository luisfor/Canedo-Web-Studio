{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Catálogo de herramientas del kit, esquema 1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "catalogVersion",
    "updatedAt",
    "scope",
    "tools"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "catalogVersion": {
      "type": "string",
      "pattern": "^(0|[1-9]\\d*)\\.(0|[1-9]\\d*)\\.(0|[1-9]\\d*)$"
    },
    "updatedAt": {
      "type": "string",
      "format": "calendar-date"
    },
    "scope": {
      "const": "metadata-only"
    },
    "tools": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "kind",
          "description",
          "availability",
          "sources",
          "versionPolicy",
          "dependencies",
          "optionalDependencies",
          "conflicts"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{0,63}$"
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "kind": {
            "enum": [
              "runtime",
              "compiler",
              "package-manager",
              "database-client",
              "database-service",
              "sdk",
              "ide",
              "infrastructure",
              "quality",
              "project-package",
              "utility"
            ]
          },
          "description": {
            "type": "string",
            "minLength": 1,
            "maxLength": 700
          },
          "availability": {
            "enum": [
              "diagnostic",
              "documented"
            ]
          },
          "sources": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "url",
                "purpose"
              ],
              "properties": {
                "url": {
                  "type": "string",
                  "format": "public-https-source",
                  "maxLength": 600
                },
                "purpose": {
                  "enum": [
                    "documentation",
                    "release-policy",
                    "project-policy"
                  ]
                }
              }
            }
          },
          "versionPolicy": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "state",
              "note"
            ],
            "properties": {
              "state": {
                "enum": [
                  "declared",
                  "unassessed"
                ]
              },
              "note": {
                "type": "string",
                "minLength": 1,
                "maxLength": 700
              },
              "requirement": {
                "type": "object",
                "additionalProperties": false,
                "minProperties": 1,
                "properties": {
                  "min": {
                    "type": "string",
                    "pattern": "^\\d+(\\.\\d+){0,2}$"
                  },
                  "maxExclusive": {
                    "type": "string",
                    "pattern": "^\\d+(\\.\\d+){0,2}$"
                  },
                  "majors": {
                    "type": "array",
                    "minItems": 1,
                    "maxItems": 30,
                    "uniqueItems": true,
                    "items": {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 9999
                    }
                  }
                }
              },
              "evidence": {
                "type": "string",
                "format": "public-https-source"
              },
              "reviewedAt": {
                "type": "string",
                "format": "calendar-date"
              }
            },
            "allOf": [
              {
                "if": {
                  "properties": {
                    "state": {
                      "const": "declared"
                    }
                  }
                },
                "then": {
                  "required": [
                    "requirement",
                    "evidence",
                    "reviewedAt"
                  ]
                },
                "else": {
                  "not": {
                    "anyOf": [
                      {
                        "required": [
                          "requirement"
                        ]
                      },
                      {
                        "required": [
                          "evidence"
                        ]
                      },
                      {
                        "required": [
                          "reviewedAt"
                        ]
                      }
                    ]
                  }
                }
              }
            ]
          },
          "diagnostic": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "command",
              "args"
            ],
            "properties": {
              "command": {
                "type": "string",
                "pattern": "^[a-zA-Z0-9][a-zA-Z0-9.+_-]*$",
                "maxLength": 80
              },
              "args": {
                "type": "array",
                "minItems": 1,
                "maxItems": 3,
                "items": {
                  "enum": [
                    "--version",
                    "-version",
                    "version",
                    "-V",
                    "-?",
                    "-v"
                  ]
                }
              }
            }
          },
          "platforms": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "win32",
                "darwin",
                "linux"
              ]
            }
          },
          "dependencies": {
            "type": "array",
            "maxItems": 50,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "reason"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]{0,63}$"
                },
                "reason": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 400
                }
              }
            }
          },
          "optionalDependencies": {
            "type": "array",
            "maxItems": 50,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "reason"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[a-z][a-z0-9-]{0,63}$"
                },
                "reason": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 400
                }
              }
            }
          },
          "conflicts": {
            "type": "array",
            "maxItems": 50,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{0,63}$"
            }
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "availability": {
                  "const": "diagnostic"
                }
              }
            },
            "then": {
              "required": [
                "diagnostic"
              ]
            },
            "else": {
              "not": {
                "required": [
                  "diagnostic"
                ]
              }
            }
          }
        ]
      }
    }
  }
}
